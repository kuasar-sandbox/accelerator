# Total RAM and NVMe budgets, in bytes. tiered_max_file_size is divided across
# proactor threads by Dragonfly; it is not a per-thread value.
DRAGONFLY_MAX_MEMORY=412316860416
DRAGONFLY_TIER_PREFIX=/mnt/ssd/dragonfly/tier
DRAGONFLY_TIER_BYTES=5497558138880

# Ratios of free memory. Start background offload below 40% free; stop
# promoting disk reads back into RAM below 20% free.
DRAGONFLY_TIER_OFFLOAD_THRESHOLD=0.4
DRAGONFLY_TIER_UPLOAD_THRESHOLD=0.2
DRAGONFLY_PROACTOR_THREADS=16
